# Chat UI (issue 3.2). Copy to .env.local; never commit it.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Google sign-in through Supabase Auth (decision 3 on #266): the project's URL and anon key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local development without Supabase: 1 shows "Đăng nhập dev", which needs DEV_LOGIN=true on the API.
NEXT_PUBLIC_DEV_LOGIN=0
