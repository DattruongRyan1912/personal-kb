# ==============================================================================
# Personal Knowledge Base — Environment Configuration Template
# Copy this file to .env and fill in your actual credentials. NEVER commit .env!
# ==============================================================================

# Database Settings (PostgreSQL 17 with pgvector)
PG_USER=kb_user
PG_PASSWORD=your_secure_postgres_password_here
PG_DATABASE=knowledge_db
PG_PORT=5433

# AI Reasoning & Chat (DeepSeek API or OpenAI or Ollama)
# Get your DeepSeek API key at https://platform.deepseek.com
OPENAI_API_KEY=sk-your_api_key_here
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_MODEL_THOROUGH=deepseek-chat
LLM_REASONING_EFFORT=none

# Vector Embedding Model (Ollama local recommended for $0 cost)
# Run locally: ollama run bge-m3
EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024

# Optimization & Cost Control
# Set AGENT_READ_SPECS=false to enable Chunk-based RAG (saves 95%+ tokens on large files)
AGENT_READ_SPECS=false
AGENT_MAX_TOOL_CALLS=12

# Security & Dev Auth
SUPABASE_JWT_SECRET=your_custom_jwt_secret_at_least_32_characters_long
